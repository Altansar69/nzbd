# Copy to deploy/.env (gitignored). Values containing $ MUST stay single-quoted.
NZBD_SITE=nzbd.lan
NZBD_PROXY_USER=admin
# Generate: docker run --rm caddy:2 caddy hash-password --plaintext 'your-proxy-password'
NZBD_PROXY_HASH='$2a$14$REPLACE_ME'
# LAN address to publish on (never 0.0.0.0 on a public host) and port.
NZBD_BIND=127.0.0.1
NZBD_HTTPS_PORT=443
# Data directory (library, search index, SQLite database): a NEW directory, absolute path recommended.
NZBD_DATA_DIR=./storage/data
# Keys (TOTP, database passwords), state, proxy certificates and PostgreSQL files: plain host folders created by install.sh
# (secrets, state, caddy, and with PostgreSQL setup_secrets, pg_data, pg_secrets). Not Docker volumes, so `docker compose
# down -v` cannot delete them. Outside and apart from the data directory; absolute path recommended; back it up.
NZBD_VOLUMES_DIR=./storage
# Database backend, chosen once: sqlite (default) or postgres. Never switched for an existing library.
NZBD_DB_BACKEND=sqlite
# PostgreSQL only: folder of the database files (uid 999, mode 0700); default <NZBD_VOLUMES_DIR>/pg_data.
#NZBD_PG_DATA_DIR=/srv/nzbd/pg_data
# The numeric user:group nzbd runs as (required, never 0). Your own (id -u / id -g) lets you manage the data
# directory without sudo; 10001:10001 is the image's user. Owns the storage folder (data directory and key folders).
NZBD_UID=1000
NZBD_GID=1000
# Optional: prefix of the containers (<prefix>, <prefix>-proxy, <prefix>-db) and of the PostgreSQL socket volume
# (<prefix>_pg_socket). Lowercase letters, digits, _ and -. Change it only for a second stack on the same host (or tests).
#NZBD_NAME_PREFIX=nzbd
# Never set NZBD_IMAGE / NZBD_PROXY_IMAGE here: the stack runs nzbd:local / nzbd-proxy:local built from this tree.
